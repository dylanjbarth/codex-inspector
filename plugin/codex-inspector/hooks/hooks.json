{
  "description": "Non-blocking Codex Inspector lifecycle signals",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "${PLUGIN_ROOT}/hooks/inspector-hook.sh", "timeout": 2 }] }]
  }
}
