{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-inspector.local/schemas/reviews/run-v1.json",
  "title": "Codex Inspector Review Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "status", "createdAt", "command"],
  "properties": {
    "schemaVersion": { "const": "inspector.review/v1" },
    "reviewId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["planned", "running", "complete", "failed", "unrenderable"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "threadId": { "$ref": "#/$defs/id" },
    "launchPromptVersion": { "const": "inspector.review-launch/v2" },
    "pid": { "type": "integer", "minimum": 1 },
    "exitCode": { "type": "integer" },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptedReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diagnostics": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 500 }
    },
    "failureCode": { "type": "string", "maxLength": 100 },
    "failureMessage": { "type": "string", "maxLength": 2000 },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "datasetEpoch", "indexRevision", "scope", "model", "reasoning"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/id" },
        "datasetEpoch": { "$ref": "#/$defs/id" },
        "indexRevision": { "type": "integer", "minimum": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "projectName": { "type": "string", "maxLength": 1000 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reasoning": { "type": "string", "minLength": 1, "maxLength": 200 },
        "focus": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "running" } }, "required": ["status"] },
      "then": { "required": ["startedAt", "threadId", "pid", "launchPromptVersion"] }
    },
    {
      "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
      "then": { "required": ["startedAt", "completedAt", "threadId", "launchPromptVersion", "acceptedReportSha256"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["failed", "unrenderable"] } }, "required": ["status"] },
      "then": { "required": ["completedAt", "failureCode", "failureMessage"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "rootSessionId"], "properties": { "kind": { "const": "single_session" }, "rootSessionId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "start", "end", "timezone"], "properties": { "kind": { "const": "time_period" }, "start": { "type": "string", "format": "date-time" }, "end": { "type": "string", "format": "date-time" }, "timezone": { "type": "string", "minLength": 1 }, "projectId": { "$ref": "#/$defs/id" } } }
      ]
    }
  }
}
